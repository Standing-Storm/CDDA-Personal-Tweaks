  {
    "id": "death_guilt",
    "type": "SPELL",
    "name": { "str": "Death Guilt", "//~": "NO_I18N" },
    "description": { "str": "Feeling guilty over killing a monster.", "//~": "NO_I18N" },
    "valid_targets": [ "hostile" ],
    "flags": [ "SILENT", "NO_PROJECTILE", "NO_EXPLOSION_SFX" ],
    "shape": "blast",
    "effect": "noise",
    "min_damage": 1,
    "min_range": 20,
    "max_range": 20
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_CAUSE_GUILT",
    "condition": {
      "and": [
        { "not": { "u_has_flag": "PSYCHOPATH" } },
        { "not": { "u_has_flag": "NUMB" } },
        { "not": { "u_has_flag": "PRED3" } },
        { "not": { "u_has_flag": "PRED4" } }
      ]
    },
    "effect": [
      {
        "u_add_morale": "morale_killed_monster",
        "bonus": { "math": [ "-15 + min( (u_guilt_causing_child_monster_kills / 25), 10)" ] },
        "max_bonus": -75,
        "duration": "24 hours",
        "decay_start": "12 hours"
      },
      { "u_message": "You feel guilty for killing the <npc_name>." }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_FERAL_DEATH_GUILT_CHANCE",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "condition": {
      "and": [
        "u_is_avatar",
        { "npc_has_species": "FERAL" },
        {
          "and": [
            { "not": { "u_has_flag": "PSYCHOPATH" } },
            { "not": { "u_has_flag": "NUMB" } },
            { "not": { "u_has_flag": "PRED3" } },
            { "not": { "u_has_flag": "PRED4" } }
          ]
        }
      ]
    },
    "effect": [
      { "math": [ "_guilt_variable = 3" ] },
      { "if": { "u_has_trait": "PACIFIST" }, "then": { "math": [ "_guilt_variable += 4" ] } },
      {
        "if": { "x_in_y_chance": { "x": { "math": [ "_guilt_variable" ] }, "y": 200 } },
        "then": { "u_add_effect": { "effect": "effect_death_guilt", "duration": "24 hours" } }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_ZOMBIE_DEATH_GUILT_CHANCE",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "condition": {
      "and": [
        "u_is_avatar",
        {
          "and": [
            { "not": { "u_has_flag": "PSYCHOPATH" } },
            { "not": { "u_has_flag": "NUMB" } },
            { "not": { "u_has_flag": "PRED3" } },
            { "not": { "u_has_flag": "PRED4" } }
          ]
        },
        { "and": [ { "npc_has_species": "ZOMBIE" }, { "npc_has_species": "HUMAN" } ] }
      ]
    },
    "effect": [
      { "math": [ "_guilt_variable = 1" ] },
      { "if": { "u_has_trait": "PACIFIST" }, "then": { "math": [ "_guilt_variable += 2" ] } },
      { "if": { "npc_has_flag": "CAUSES_CHILD_GUILT_MONSTER" }, "then": { "math": [ "_guilt_variable += 4" ] } },
      {
        "if": { "x_in_y_chance": { "x": { "math": [ "_guilt_variable" ] }, "y": 200 } },
        "then": { "u_add_effect": { "effect": "effect_death_guilt", "duration": "24 hours" } }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_DEATH_GUILT_CHANCE_FOR_NIGHTMARES",
    "eoc_type": "EVENT",
    "required_event": "character_falls_asleep",
    "condition": { "u_has_effect": "effect_death_guilt" },
    "effect": [
      {
        "if": {
          "x_in_y_chance": {
            "x": { "math": [ "u_effect_intensity('effect_death_guilt)" ] },
            "y": { "math": [ "15 + u_effect_intensity('effect_long_term_desensitization') * 2" ] }
          }
        },
        "then": [ { "u_add_effect": { "effect": "nightmares", "duration": "12 hours" } } ]
      },
      {
        "if": {
          "x_in_y_chance": {
            "x": { "math": [ "u_effect_intensity('effect_death_guilt)" ] },
            "y": { "math": [ "25 + u_effect_intensity('effect_long_term_desensitization') * 3" ] }
          }
        },
        "then": [
          { "u_add_effect": { "effect": "nightmares", "duration": "12 hours" } },
          { "u_add_effect": { "effect": "effect_acquired_death_guilt", "duration": "10 days" } }
        ]
      },
      { "u_lose_effect": "effect_death_guilt" },
      {
        "if": { "x_in_y_chance": { "x": { "math": [ "u_effect_intensity('effect_acquired_death_guilt)" ] }, "y": 10 } },
        "then": [ { "u_add_effect": { "effect": "effect_long_term_desensitization", "duration": "PERMANENT" } } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_DEATH_GUILT_CHANCE_FOR_TEMPORARY_BAD_TRAITS",
    "eoc_type": "EVENT",
    "required_event": "character_wakes_up",
    "condition": {
      "and": [
        { "not": { "u_has_flag": "PSYCHOPATH" } },
        { "not": { "u_has_flag": "NUMB" } },
        { "not": { "u_has_flag": "PRED3" } },
        { "not": { "u_has_flag": "PRED4" } },
        {
          "or": [ { "u_has_effect": "effect_long_term_desensitization" }, { "u_has_effect": "effect_acquired_death_guilt" } ]
        }
      ]
    },
    "effect": [
      {
        "if": { "x_in_y_chance": { "x": 1, "y": { "math": [ "8 + u_effect_intensity('effect_long_term_desensitization')" ] } } },
        "then": [ { "u_add_effect": "effect_morale_system_bad_mood_container", "duration": "16 hours" } ]
      },
      {
        "if": { "x_in_y_chance": { "x": 1, "y": { "math": [ "12 + u_effect_intensity('effect_long_term_desensitization')" ] } } },
        "then": [ { "u_add_effect": "effect_morale_system_moodswings_container", "duration": "16 hours" } ]
      },
      {
        "if": {
          "x_in_y_chance": { "x": 1, "y": { "math": [ "25 + u_effect_intensity('effect_long_term_desensitization') * 1.5" ] } }
        },
        "then": [ { "u_add_effect": "effect_morale_system_jittery_container", "duration": "16 hours" } ]
      },
      {
        "if": {
          "x_in_y_chance": { "x": 1, "y": { "math": [ "15 + (u_effect_intensity('effect_long_term_desensitization') / 2)" ] } }
        },
        "then": [ { "u_add_effect": "effect_morale_system_moodswings_container", "duration": "16 hours" } ]
      }
    ]
  }
]
